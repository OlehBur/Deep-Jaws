    - target: {fileID: 3509759555800217615, guid: 1e3e8318f83d81f4584c5c64acfef9b5, type: 3}
      propertyPath: m_text
      value: "\u041F\u043E\u043C\u0438\u043B\u043A\u0430 \u0432\u0435\u0440\u0438\u0444\u0456\u043A\u0430\u0446\u0456\u0457
