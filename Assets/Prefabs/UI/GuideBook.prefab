  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\tThe ocean floor has clearly defined rules of the food chain, where everything
    starts with crabs, and each subsequent link can eat the previous creature or
    its own kind. \r\n\t<s>When you reach a certain level, enemies of the same level
    will not attack you due to the herd protection effect, but they may attack each
    other from time to time. </s><u>You can only eat fish of your own species when
    they are smaller than you; and with each level of your own growth, weaker fish
    will not appear. </u>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2e498d1c8094910479dc3e1b768306a4, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 2e498d1c8094910479dc3e1b768306a4, type: 2}
