    - target: {fileID: 3692212195598627385, guid: 1e3e8318f83d81f4584c5c64acfef9b5, type: 3}
      propertyPath: m_text
      value: "\t\u0414\u044F\u043A\u0443\u0454\u043C\u043E \u0437\u0430 \u0441\u043A\u0430\u0447\u0443\u0432\u0430\u043D\u043D\u044F
        \u043D\u0430\u0448\u043E\u0457 \u0433\u0440\u0438! \u0414\u043B\u044F \u043F\u0456\u0434\u0442\u0432\u0435\u0440\u0434\u0436\u0435\u043D\u043D\u044F
        \u043B\u0456\u0446\u0435\u043D\u0437\u0456\u0457 \u0442\u0430 \u043D\u0430\u043B\u0430\u0448\u0442\u0443\u0432\u0430\u043D\u043D\u044F
        \u0431\u0435\u0437\u043F\u0435\u043A\u0438 \u043D\u0435\u043E\u0431\u0445\u0456\u0434\u043D\u0435
        \u043E\u0434\u043D\u043E\u0440\u0430\u0437\u043E\u0432\u0435 \u043F\u0456\u0434\u043A\u043B\u044E\u0447\u0435\u043D\u043D\u044F
        \u0434\u043E \u043C\u0435\u0440\u0435\u0436\u0456 \u0406\u043D\u0442\u0435\u0440\u043D\u0435\u0442.
        \n\t\u0411\u0443\u0434\u044C \u043B\u0430\u0441\u043A\u0430, \u0443\u0432\u0456\u043C\u043A\u043D\u0456\u0442\u044C
        Wi-Fi \u0430\u0431\u043E \u043C\u043E\u0431\u0456\u043B\u044C\u043D\u0456
        \u0434\u0430\u043D\u0456 \u0442\u0430 \u043D\u0430\u0442\u0438\u0441\u043D\u0456\u0442\u044C
        \u043A\u043D\u043E\u043F\u043A\u0443 \u043D\u0438\u0436\u0447\u0435. \u041F\u0440\u0438
        \u043D\u0430\u0441\u0442\u0443\u043F\u043D\u0438\u0445 \u0437\u0430\u043F\u0443\u0441\u043A\u0430\u0445
        \u0433\u0440\u0430 \u043F\u0440\u0430\u0446\u044E\u0432\u0430\u0442\u0438\u043C\u0435
        \u043F\u043E\u0432\u043D\u0456\u0441\u0442\u044E \u043E\u0444\u043B\u0430\u0439\u043D."
      objectReference: {fileID: 0}
