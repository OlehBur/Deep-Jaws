  m_TableData:
  - m_Id: 10688688128
    m_Localized: "Fortsetzen\r"
    m_Metadata:
      m_Items: []
  - m_Id: 217186856960
    m_Localized: "Neues Spiel\r"
    m_Metadata:
      m_Items: []
  - m_Id: 337680822272
    m_Localized: Einstellungen
    m_Metadata:
      m_Items: []
  - m_Id: 395583188992
    m_Localized: Beenden
    m_Metadata:
      m_Items: []
  - m_Id: 515909382144
    m_Localized: Achtung!
    m_Metadata:
      m_Items: []
  - m_Id: 645551124480
    m_Localized: "\tBist du sicher, dass du ein neues Spiel starten m\xF6chtest?
      Dein gesamter bisheriger Fortschritt wird gel\xF6scht!!!\r"
    m_Metadata:
      m_Items: []
  - m_Id: 1028214255616
    m_Localized: "Best\xE4tigen\r"
    m_Metadata:
      m_Items: []
  - m_Id: 1164646576128
    m_Localized: "Abbrechen\r"
    m_Metadata:
      m_Items: []
  - m_Id: 9368017334272
    m_Localized: "Ton\r"
    m_Metadata:
      m_Items: []
  - m_Id: 9537102311424
    m_Localized: "Sprache und Benutzeroberfl\xE4che"
    m_Metadata:
      m_Items: []
  - m_Id: 9909636198400
    m_Localized: Gesamt
    m_Metadata:
      m_Items: []
  - m_Id: 10000124112896
    m_Localized: Musik
    m_Metadata:
      m_Items: []
  - m_Id: 10016284766208
    m_Localized: Effekte
    m_Metadata:
      m_Items: []
  - m_Id: 13151204044800
    m_Localized: "\xDCberspringen"
    m_Metadata:
      m_Items: []
  - m_Id: 13225590026240
    m_Localized: Los geht's!
    m_Metadata:
      m_Items: []
  - m_Id: 93542472511488
    m_Localized: Spiel Fortsetzen
    m_Metadata:
      m_Items: []
  - m_Id: 11343564878934016
    m_Localized: "\tBist du sicher, dass du das Spiel speichern und beenden m\xF6chtest?
      Die Gegnerkarte wird zuf\xE4llig neu generiert! Es werden nur die Spielerdaten
      und die Kartendaten gespeichert."
    m_Metadata:
      m_Items: []
  - m_Id: 11348055812501504
    m_Localized: "Speichern und Beenden\r"
    m_Metadata:
      m_Items: []
  - m_Id: 19167526644117504
    m_Localized: "L\xE4dt............"
    m_Metadata:
      m_Items: []
  - m_Id: 20801275362308096
    m_Localized: "Sprache ausw\xE4hlen"
    m_Metadata:
      m_Items: []
  - m_Id: 29841660533305344
    m_Localized: Spielanleitung
    m_Metadata:
      m_Items: []
  - m_Id: 30083995204612096
    m_Localized: Grafikeinstellungen
    m_Metadata:
      m_Items: []
  - m_Id: 30151414853955584
    m_Localized: Schattenentfernung
    m_Metadata:
      m_Items: []
  - m_Id: 30151368582393856
    m_Localized: Schatten
    m_Metadata:
      m_Items: []
  - m_Id: 30151344859410432
    m_Localized: Vignette <color=#FF7858>(Neustart erforderlich)</color>
    m_Metadata:
      m_Items: []
  - m_Id: 30151229537021952
    m_Localized: Bloom <color=#FF7858>(Neustart erforderlich)</color>
    m_Metadata:
      m_Items: []
  - m_Id: 30151452871127040
    m_Localized: "Grafikqualit\xE4t"
    m_Metadata:
      m_Items: []
  - m_Id: 30151497733402624
    m_Localized: "Schattenqualit\xE4t"
    m_Metadata:
      m_Items: []
  - m_Id: 31963168781135872
    m_Localized: Schattenkorrektur
    m_Metadata:
      m_Items: []
  - m_Id: 31964497834438656
    m_Localized: "Zur\xFCcksetzen"
    m_Metadata:
      m_Items: []
  - m_Id: 31964646879031296
    m_Localized: Vorschau
    m_Metadata:
      m_Items: []
  - m_Id: 45985350800666624
    m_Localized: "W\xE4hlen Sie den Spielmodus"
    m_Metadata:
      m_Items: []
  - m_Id: 45985353409523712
    m_Localized: Meeresbrise
    m_Metadata:
      m_Items: []
  - m_Id: 45985355057885184
    m_Localized: Ozeanreise
    m_Metadata:
      m_Items: []
  - m_Id: 45985685065723904
    m_Localized: "T\xF6dlicher Strudel"
    m_Metadata:
      m_Items: []
  - m_Id: 45986534294843392
    m_Localized: "\tDies ist <u>leichteste Spielmodus</u>. Gegner verursachen nur
      sehr wenig Schaden, und ihre Erscheinungsrate ist sehr gering und au\xDFerdem
      wachsen sie dreimal langsamer. W\xE4hle diesen Modus, wenn du zum ersten Mal
      spielst und einfach fast sorgenfrei durchs Meer gleiten m\xF6chtest.\n\t\t<u>Die
      geringsten Einnahmen aus Muscheln. Nicht verf\xFCgbare Quests aus dem Meeresschutzgebiet</u>"
    m_Metadata:
      m_Items: []
  - m_Id: 45986604117422080
    m_Localized: "\tDieser Modus ist die <u>klassische Grundversion</u>. Gegner verursachen
      genauso viel Schaden wie du, und ihre Erscheinungsrate ist ausgewogen f\xFCr
      ein fesselndes Spielerlebnis. W\xE4hle diesen Modus, wenn du das Spiel so erleben
      m\xF6chtest, wie es urspr\xFCnglich geschaffen wurde."
    m_Metadata:
      m_Items: []
  - m_Id: 45986606533341184
    m_Localized: "\t<u>Der schwierigste Spielmodus</u>. Feindliche Fische erscheinen
      so zahlreich wie friedliche. Der Tod ist endg\xFCltig, du verlierst gesamten
      Spielfortschritt. Auch Fische deiner Art greifen dich an, wenn du kleiner bist.
      Dieser Modus ist f\xFCr jene gedacht, denen die vorherigen zu leicht erscheinen.
      W\xE4hle ihn nur, wenn du versprichst, dem Spiel wegen seiner Schwierigkeit
      keine schlechteste Bewertung zu geben.\n\t<u>H\xF6chster Muschelverdienst.</u>"
    m_Metadata:
      m_Items: []
  - m_Id: 114155322680569856
    m_Localized: Das Meer hat dich verschlungen
    m_Metadata:
      m_Items: []
  - m_Id: 114177700735250432
    m_Localized: Neustart auf Niedrigerer Stufe
    m_Metadata:
      m_Items: []
  - m_Id: 114177730430922752
    m_Localized: Sofort wiederbeleben (Anzeige)
    m_Metadata:
      m_Items: []
  - m_Id: 114664986816049152
    m_Localized: 'Respawns heute:'
    m_Metadata:
      m_Items: []
  - m_Id: 115270974627672064
    m_Localized: Treue wird belohnt!
    m_Metadata:
      m_Items: []
  - m_Id: 115271348147220480
    m_Localized: "Du hast dieses Spiel gekauft, als es noch kostenpflichtig war \u2013
      und ich habe das nicht vergessen.\nDu hast mich unterst\xFCtzt, jetzt ist es
      meine Aufgabe, dich zu unterst\xFCtzen.\nDein Konto wurde dauerhaft auf Premium
      Founder hochgestuft!\n\u2022 Keine Unterbrecher-Werbung\n\u2022 Kostenlose
      Sofort-Wiederbelebungen (t\xE4glich begrenzt)\nTauche wieder ein und herrsche
      \xFCber die Tiefen!"
    m_Metadata:
      m_Items: []
  - m_Id: 115537725315641344
    m_Localized: Automatischer Respawn in
    m_Metadata:
      m_Items: []
  - m_Id: 115606966563794944
    m_Localized: Tiefsee-Store
    m_Metadata:
      m_Items: []
  - m_Id: 115611060871393280
    m_Localized: Skins
    m_Metadata:
      m_Items: []
  - m_Id: 115611386009645056
    m_Localized: Konto & Support
    m_Metadata:
      m_Items: []
  - m_Id: 115611535062626304
    m_Localized: Abenteuer-Erweiterung
    m_Metadata:
      m_Items: []
  - m_Id: 115612159640629248
    m_Localized: In Entwicklung...
    m_Metadata:
      m_Items: []
  - m_Id: 116730165544382464
    m_Localized: Quecksilber
    m_Metadata:
      m_Items: []
  - m_Id: 116730920858841088
    m_Localized: Unsichtbar
    m_Metadata:
      m_Items: []
  - m_Id: 116731174723284992
    m_Localized: "Cham\xE4leon"
    m_Metadata:
      m_Items: []
  - m_Id: 116732438383194112
    m_Localized: Zwischenwerbung Entfernen
    m_Metadata:
      m_Items: []
  - m_Id: 116732511938703360
    m_Localized: 'Premium: Keine Werbung + kostenloser Respawn'
    m_Metadata:
      m_Items: []
  - m_Id: 116732513415098368
    m_Localized: "Unterst\xFCtze den Entwickler"
    m_Metadata:
      m_Items: []
  - m_Id: 116837319567765504
    m_Localized: Aschfluss
    m_Metadata:
      m_Items: []
  - m_Id: 116843824887132160
    m_Localized: Beliebt
    m_Metadata:
      m_Items: []
  - m_Id: 116844027606233088
    m_Localized: Mystisch
    m_Metadata:
      m_Items: []
  - m_Id: 116844182787092480
    m_Localized: Bester Preis
    m_Metadata:
      m_Items: []
  - m_Id: 117439701141975040
    m_Localized: Keine Internetverbindung
    m_Metadata:
      m_Items: []
  - m_Id: 117439879345369088
    m_Localized: "Sie sind derzeit offline.  \r\nEine Internetverbindung ist erforderlich,
      um auf Erfolge, Bestenlisten und den Shop mit exklusiven Artikeln zuzugreifen
      sowie um einzigartige Belohnungen zu erhalten.  \r\n\r\nBitte stellen Sie sicher,
      dass Ihre Verbindung stabil ist, und starten Sie das Spiel neu.\r\n"
    m_Metadata:
      m_Items: []
  - m_Id: 117510486711889920
    m_Localized: Gekauft
    m_Metadata:
      m_Items: []
  - m_Id: 117510546602356736
    m_Localized: "Ausw\xE4hlen"
    m_Metadata:
      m_Items: []
  - m_Id: 117510603175129088
    m_Localized: "Ausgew\xE4hlt"
    m_Metadata:
      m_Items: []
  - m_Id: 118087099056943104
    m_Localized: "K\xE4ufe wiederherstellenx`"
    m_Metadata:
      m_Items: []
  - m_Id: 123258979858542592
    m_Localized: Erste Spieleinrichtung
    m_Metadata:
      m_Items: []
  - m_Id: 123259300961873920
    m_Localized: "\tVielen Dank f\xFCr das Herunterladen unseres Spiels! Zur Best\xE4tigung
      der Lizenz und zur Einrichtung der Sicherheit ist eine einmalige Verbindung
      zum Internet erforderlich.\n\tBitte aktivieren Sie WLAN oder mobile Daten und
      dr\xFCcken Sie die Schaltfl\xE4che unten. Bei sp\xE4teren Starts l\xE4uft das
      Spiel vollst\xE4ndig offline."
    m_Metadata:
      m_Items: []
  - m_Id: 123259699752103936
    m_Localized: "Erneut pr\xFCfen"
    m_Metadata:
      m_Items: []
  - m_Id: 123260350309625856
    m_Localized: "App\u2011Verifizierungsfehler"
    m_Metadata:
      m_Items: []
  - m_Id: 123260534586372096
    m_Localized: "\tEntschuldigen Sie die Unannehmlichkeiten. Das System konnte die
      Lizenz dieser Spielkopie nicht best\xE4tigen.\nM\xF6gliche Gr\xFCnde:\n\u2003\u2022
      Sie verwenden eine inoffizielle Version des Spiels, die nicht aus dem Google
      Play Store heruntergeladen wurde.\n\u2003Wenn Sie das Spiel offiziell erworben
      haben, stellen Sie bitte eine stabile Internetverbindung sicher und versuchen
      Sie es erneut. Andernfalls unterst\xFCtzen Sie bitte den Entwickler und installieren
      Sie die offizielle Version."
    m_Metadata:
      m_Items: []
  - m_Id: 123260777721786368
    m_Localized: Erneut Versuchen
    m_Metadata:
      m_Items: []
  - m_Id: 128240278268571648
    m_Localized: Bildrate (FPS)
    m_Metadata:
      m_Items: []
  - m_Id: 128271903157153792
    m_Localized: Max.
    m_Metadata:
      m_Items: []
  - m_Id: 128799057087328256
    m_Localized: 'Herr der Tiefe:'
    m_Metadata:
      m_Items: []
  - m_Id: 129347348820684800
    m_Localized: Bis zu 70% Rabatt!
    m_Metadata:
      m_Items: []
  - m_Id: 129477177389903872
    m_Localized: "N\xE4chster Skin"
    m_Metadata:
      m_Items: []
  - m_Id: 131877166405677056
    m_Localized: Alles klar
    m_Metadata:
      m_Items: []
  - m_Id: 131877385172185088
    m_Localized: Ja
    m_Metadata:
      m_Items: []
  - m_Id: 131877448246128640
    m_Localized: Nein
    m_Metadata:
      m_Items: []
  - m_Id: 140372537033388032
    m_Localized: UI automatisch ausblenden
    m_Metadata:
      m_Items: []
  - m_Id: 142555872736342016
    m_Localized: "Fernunsch\xE4rfe <color=#FF7858>(Neustart erforderlich)</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 143907762107609088
    m_Localized: "Vielen Dank f\xFCrs Spielen! "
    m_Metadata:
      m_Items: []
  - m_Id: 143907781074251776
    m_Localized: "\tDu hast die grundlegenden Fischarten im Start-Biom \u201EKorallenriffe\u201C
      freigeschaltet. M\xF6chtest du alle 9 Raubfischarten erkunden, geheime Orte
      freischalten, neue Effekte und Biome entdecken und Zugang zu neuen Spielmodi
      und Spielmechaniken erhalten?"
    m_Metadata:
      m_Items: []
  - m_Id: 143907799529189376
    m_Localized: Hol dir das Komplette Spiel
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
