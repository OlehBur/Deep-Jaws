  - m_Id: 117439879345369088
    m_Localized: "\u0412\u0438 \u043F\u0435\u0440\u0435\u0431\u0443\u0432\u0430\u0454\u0442\u0435
      \u043E\u0444\u043B\u0430\u0439\u043D.  \r\n\u0414\u043B\u044F \u0434\u043E\u0441\u0442\u0443\u043F\u0443
      \u0434\u043E \u0434\u043E\u0441\u044F\u0433\u043D\u0435\u043D\u044C, \u0442\u0430\u0431\u043B\u0438\u0446\u044C
      \u043B\u0456\u0434\u0435\u0440\u0456\u0432 \u0442\u0430 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0443
      \u0437 \u0435\u043A\u0441\u043A\u043B\u044E\u0437\u0438\u0432\u043D\u0438\u043C\u0438
      \u0442\u043E\u0432\u0430\u0440\u0430\u043C\u0438, \u0430 \u0442\u0430\u043A\u043E\u0436
      \u0434\u043B\u044F \u043E\u0442\u0440\u0438\u043C\u0430\u043D\u043D\u044F \u0443\u043D\u0456\u043A\u0430\u043B\u044C\u043D\u0438\u0445
      \u0432\u0438\u043D\u0430\u0433\u043E\u0440\u043E\u0434 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0435
      \u0456\u043D\u0442\u0435\u0440\u043D\u0435\u0442\u2011\u0437\u2019\u0454\u0434\u043D\u0430\u043D\u043D\u044F. 
      \r\n\r\n\u0411\u0443\u0434\u044C \u043B\u0430\u0441\u043A\u0430, \u043F\u0435\u0440\u0435\u043A\u043E\u043D\u0430\u0439\u0442\u0435\u0441\u044F
      \u0443 \u0441\u0442\u0430\u0431\u0456\u043B\u044C\u043D\u043E\u0441\u0442\u0456
      \u0437\u2019\u0454\u0434\u043D\u0430\u043D\u043D\u044F \u0442\u0430 \u043F\u0435\u0440\u0435\u0437\u0430\u043F\u0443\u0441\u0442\u0456\u0442\u044C
      \u0433\u0440\u0443.\r\n"
