    m_Metadata:
      m_Items: []
  - m_Id: 45985350800666624
    m_Localized: "\u0412\u0438\u0431\u0456\u0440 \u0420\u0435\u0436\u0438\u043C\u0443
      \u0413\u0440\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 45985353409523712
    m_Localized: "\u041C\u043E\u0440\u0441\u044C\u043A\u0438\u0439 \u0411\u0440\u0438\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 45985355057885184
    m_Localized: "\u041E\u043A\u0435\u0430\u043D\u0441\u044C\u043A\u0430 \u041F\u043E\u0434\u043E\u0440\u043E\u0436"
    m_Metadata:
      m_Items: []
  - m_Id: 45985685065723904
    m_Localized: "\u0421\u043C\u0435\u0440\u0442\u0435\u043B\u044C\u043D\u0438\u0439
      \u0412\u0438\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 45986534294843392
    m_Localized: "\t\u0426\u0435 \u0431\u0430\u0437\u043E\u0432\u0438\u0439, <u>\u043D\u0430\u0439\u043B\u0435\u0433\u0448\u0438\u0439
      \u0440\u0435\u0436\u0438\u043C \u0433\u0440\u0438</u>. \u0412\u043E\u0440\u043E\u0433\u0438
      \u043D\u0430\u043D\u043E\u0441\u044F\u0442\u044C \u0434\u0443\u0436\u0435 \u043C\u0430\u043B\u043E
      \u0448\u043A\u043E\u0434\u0438, \u0430 \u0457\u0445 \u0441\u043F\u0456\u0432\u0432\u0456\u0434\u043D\u043E\u0448\u0435\u043D\u043D\u044F
      \u043F\u043E\u044F\u0432\u0438 \u0434\u0443\u0436\u0435 \u043C\u0430\u043B\u0435,
      \u0430 \u0442\u0430\u043A\u043E\u0436 \u0432\u043E\u043D\u0438 \u0440\u043E\u0441\u0442\u0443\u0442\u044C
      \u0443 \u0442\u0440\u0438\u0447\u0456 \u0434\u043E\u0432\u0448\u0435. \u0412\u0438\u0431\u0438\u0440\u0430\u0439\u0442\u0435
      \u0446\u0435, \u044F\u043A\u0449\u043E \u0432\u0438 \u0432\u043F\u0435\u0440\u0448\u0435
      \u0433\u0440\u0430\u0454\u0442\u0435 \u0456 \u0432\u0430\u043C \u043F\u0440\u043E\u0441\u0442\u043E
      \u0446\u0456\u043A\u0430\u0432\u043E \u043C\u0430\u0439\u0436\u0435 \u0431\u0435\u0437\u0442\u0443\u0440\u0431\u043E\u0442\u043D\u043E
      \u043F\u043B\u0430\u0432\u0430\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 45986604117422080
    m_Localized: "\t\u0426\u0435\u0439 \u0440\u0435\u0436\u0438\u043C \u0433\u0440\u0438
      \u0454 <u>\u043A\u043B\u0430\u0441\u0438\u0447\u043D\u043E\u044E \u0431\u0430\u0437\u043E\u0432\u043E\u044E
      \u0432\u0435\u0440\u0441\u0456\u0454\u044E</u>. \u0412\u043E\u0440\u043E\u0433\u0438
      \u043D\u0430\u043D\u043E\u0441\u044F\u0442\u044C \u0441\u0442\u0456\u043B\u044C\u043A\u0438
      \u0436 \u0448\u043A\u043E\u0434\u0438 \u0449\u043E \u0439 \u0432\u0438, \u0430
      \u0457\u0445 \u0447\u0430\u0441\u0442\u043E\u0442\u0430 \u043F\u043E\u044F\u0432\u0438
      \u0432\u0440\u0456\u0432\u043D\u043E\u0432\u0430\u0436\u0435\u043D\u0430 \u0434\u043B\u044F
      \u0437\u0430\u0445\u043E\u043F\u043B\u0438\u0432\u043E\u0433\u043E \u0456\u0433\u0440\u043E\u0432\u043E\u0433\u043E
      \u0434\u043E\u0441\u0432\u0456\u0434\u0443. \u0412\u0438\u0431\u0438\u0440\u0430\u0439\u0442\u0435
      \u0446\u0435, \u044F\u043A\u0449\u043E \u0432\u0438 \u0431\u0430\u0436\u0430\u0454\u0442\u0435
      \u043D\u0430\u0441\u043E\u043B\u043E\u0434\u0438\u0442\u0438\u0441\u044C \u0433\u0440\u043E\u044E
      \u0442\u0430\u043A\u043E\u044E, \u044F\u043A\u043E\u044E \u0432\u043E\u043D\u0430
      \u0431\u0443\u043B\u0430 \u0437 \u0441\u0430\u043C\u043E\u0433\u043E \u043F\u043E\u0447\u0430\u0442\u043A\u0443
      \u0441\u0442\u0432\u043E\u0440\u0435\u043D\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 45986606533341184
    m_Localized: "\t<u>\u041D\u0430\u0439\u0432\u0430\u0436\u0447\u0438\u0439 \u0440\u0435\u0436\u0438\u043C
      \u0433\u0440\u0438</u>. \u0412\u043E\u0440\u043E\u0436\u0456 \u0440\u0438\u0431\u0438
      \u0441\u043F\u0430\u0432\u043D\u044F\u0442\u044C\u0441\u044F \u0443 \u0442\u0430\u043A\u0456\u0439
      \u0436\u0435 \u043A\u0456\u043B\u044C\u043A\u043E\u0441\u0442\u0456 \u0449\u043E
      \u0439 \u043C\u0438\u0440\u043D\u0456. \u0421\u043C\u0435\u0440\u0442\u044C
      \u0454 \u0444\u0430\u0442\u0430\u043B\u044C\u043D\u043E\u044E \u0456 \u0432\u0438
      \u0432\u0442\u0440\u0430\u0442\u0438\u0442\u0435 \u0432\u0435\u0441\u044C \u043F\u0440\u043E\u0433\u0440\u0435\u0441
      \u0433\u0440\u0438. \u0420\u0438\u0431\u0438 \u0432\u0430\u0448\u043E\u0433\u043E
      \u0432\u0438\u0434\u0443 \u0442\u0435\u043F\u0435\u0440 \u0431\u0443\u0434\u0443\u0442\u044C
      \u043D\u0430\u043F\u0430\u0434\u0430\u0442\u0438, \u044F\u043A\u0449\u043E
      \u0432\u0438 \u043C\u0435\u043D\u0448\u0456. \u0421\u0442\u0432\u043E\u0440\u0435\u043D\u0430
      \u0434\u043B\u044F \u0442\u0438\u0445 \u043A\u043E\u043C\u0443 \u043F\u043E\u043F\u0435\u0440\u0435\u0434\u043D\u0456
      \u0440\u0435\u0436\u0438\u043C\u0438 \u0437\u0434\u0430\u044E\u0442\u044C\u0441\u044F
      \u0437\u0430\u043D\u0430\u0434\u0442\u043E \u043B\u0435\u0433\u043A\u0438\u043C\u0438.
      \u041E\u0431\u0438\u0440\u0430\u0439\u0442\u0435 \u0446\u0435\u0439 \u0440\u0435\u0436\u0438\u043C
      \u0442\u0456\u043B\u044C\u043A\u0438 \u0443 \u0432\u0438\u043F\u0430\u0434\u043A\u0443
      \u043E\u0431\u0456\u0446\u044F\u043D\u043A\u0438 \u043D\u0435 \u0441\u0442\u0430\u0432\u0438\u0442\u0438
      \u043D\u0430\u0439\u043D\u0438\u0436\u0447\u0443 \u043E\u0446\u0456\u043D\u043A\u0443
      \u0433\u0440\u0456 \u0447\u0435\u0440\u0435\u0437 \u0457\u0457 \u0441\u043A\u043B\u0430\u0434\u043D\u0456\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 114155322680569856
    m_Localized: "\u0412\u0430\u0441 \u043F\u043E\u0433\u043B\u0438\u043D\u0443\u0432
      \u043E\u043A\u0435\u0430\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 114177700735250432
    m_Localized: "\u041F\u0440\u043E\u0434\u043E\u0432\u0436\u0438\u0442\u0438 \u0437
      \u0440\u0456\u0432\u043D\u044F \u043D\u0438\u0449\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 114177730430922752
    m_Localized: "\u041C\u0438\u0442\u0442\u0454\u0432\u0435 \u0432\u0456\u0434\u0440\u043E\u0434\u0436\u0435\u043D\u043D\u044F
      (\u0420\u0435\u043A\u043B\u0430\u043C\u0430)"
    m_Metadata:
      m_Items: []
  - m_Id: 114664986816049152
    m_Localized: "\u0417\u0430\u043B\u0438\u0448\u0438\u043B\u043E\u0441\u044C \u0432\u0456\u0434\u0440\u043E\u0434\u0436\u0435\u043D\u044C
      \u043D\u0430 \u0441\u044C\u043E\u0433\u043E\u0434\u043D\u0456: "
    m_Metadata:
      m_Items: []
