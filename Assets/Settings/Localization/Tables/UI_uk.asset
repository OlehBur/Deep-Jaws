    m_Localized: "\u041F\u043E\u043C\u0438\u043B\u043A\u0430 \u0412\u0435\u0440\u0438\u0444\u0456\u043A\u0430\u0446\u0456\u0457
      \u0414\u043E\u0434\u0430\u0442\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 123260534586372096
    m_Localized: "\t\u0412\u0438\u0431\u0430\u0447\u0442\u0435 \u0437\u0430 \u043D\u0435\u0437\u0440\u0443\u0447\u043D\u043E\u0441\u0442\u0456.
      \u0421\u0438\u0441\u0442\u0435\u043C\u0456 \u043D\u0435 \u0432\u0434\u0430\u043B\u043E\u0441\u044F
      \u043F\u0456\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u0438 \u043B\u0456\u0446\u0435\u043D\u0437\u0456\u044E
      \u0446\u0456\u0454\u0457 \u043A\u043E\u043F\u0456\u0457 \u0433\u0440\u0438.\n\u041C\u043E\u0436\u043B\u0438\u0432\u0456
      \u043F\u0440\u0438\u0447\u0438\u043D\u0438:\n\t\u2022 \u0412\u0438 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0454\u0442\u0435
      \u043D\u0435\u043E\u0444\u0456\u0446\u0456\u0439\u043D\u0443 \u0432\u0435\u0440\u0441\u0456\u044E
      \u0433\u0440\u0438, \u0437\u0430\u0432\u0430\u043D\u0442\u0430\u0436\u0435\u043D\u0443
      \u043D\u0435 \u0437 Google Play Store.\n\t\u042F\u043A\u0449\u043E \u0432\u0438
      \u043F\u0440\u0438\u0434\u0431\u0430\u043B\u0438 \u0433\u0440\u0443 \u043E\u0444\u0456\u0446\u0456\u0439\u043D\u043E,
      \u043F\u0435\u0440\u0435\u043A\u043E\u043D\u0430\u0439\u0442\u0435\u0441\u044F
      \u0443 \u0441\u0442\u0430\u0431\u0456\u043B\u044C\u043D\u043E\u0441\u0442\u0456
      \u0456\u043D\u0442\u0435\u0440\u043D\u0435\u0442-\u0437'\u0454\u0434\u043D\u0430\u043D\u043D\u044F
      \u0442\u0430 \u0441\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435 \u0449\u0435
      \u0440\u0430\u0437. \u0412 \u0456\u043D\u0448\u043E\u043C\u0443 \u0432\u0438\u043F\u0430\u0434\u043A\u0443,
      \u0431\u0443\u0434\u044C \u043B\u0430\u0441\u043A\u0430, \u043F\u0456\u0434\u0442\u0440\u0438\u043C\u0430\u0439\u0442\u0435
      \u0440\u043E\u0437\u0440\u043E\u0431\u043D\u0438\u043A\u0430 \u0442\u0430 \u0432\u0441\u0442\u0430\u043D\u043E\u0432\u0456\u0442\u044C
      \u043E\u0444\u0456\u0446\u0456\u0439\u043D\u0443 \u0432\u0435\u0440\u0441\u0456\u044E."
    m_Metadata:
