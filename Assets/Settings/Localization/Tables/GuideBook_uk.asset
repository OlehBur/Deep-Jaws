  m_TableData:
  - m_Id: 6565687296
    m_Localized: "\t\u0412\u0456\u0442\u0430\u044E, \u043C\u043E\u0440\u0441\u044C\u043A\u0438\u0439
      \u043C\u0430\u043D\u0434\u0440\u0456\u0432\u043D\u0438\u043A. \u0421\u044C\u043E\u0433\u043E\u0434\u043D\u0456
      \u043F\u0435\u0440\u0435\u0434 \u0442\u043E\u0431\u043E\u044E \u0441\u0442\u043E\u0457\u0442\u044C
      \u0441\u043A\u043B\u0430\u0434\u043D\u0435 \u0437\u0430\u0432\u0434\u0430\u043D\u043D\u044F
      \u2014 \u0432\u0438\u0436\u0438\u0442\u0438 \u0443 \u0434\u0438\u043A\u0438\u0445
      \u0433\u043B\u0438\u0431\u0438\u043D\u0430\u0445 \u043C\u043E\u0440\u044F.
      \u0412 \u0442\u0435\u0431\u0435 \u0454 \u0442\u0456\u043B\u044C\u043A\u0438
      \u0434\u0432\u0456 \u043E\u0441\u043D\u043E\u0432\u043D\u0456 \u0446\u0456\u043B\u0456:
      \u0437'\u0457\u0441\u0442\u0438 \u0432\u0441\u0456\u0445 \u0441\u0432\u043E\u0457\u0445
      \u0432\u043E\u0440\u043E\u0433\u0456\u0432 \u0456 \u043D\u0435 \u0431\u0443\u0442\u0438
      \u0437'\u0457\u0434\u0435\u043D\u0438\u043C \u043D\u0438\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 432891523072
    m_Localized: "\t\u0414\u043D\u043E \u043E\u043A\u0435\u0430\u043D\u0443 \u043C\u0430\u0454
      \u0447\u0456\u0442\u043A\u043E \u0432\u0438\u0437\u043D\u0430\u0447\u0435\u043D\u0456
      \u043F\u0440\u0430\u0432\u0438\u043B\u0430 \u0445\u0430\u0440\u0447\u043E\u0432\u043E\u0433\u043E
      \u043B\u0430\u043D\u0446\u044E\u0433\u0430, \u0434\u0435 \u0432\u0441\u0435
      \u043F\u043E\u0447\u0438\u043D\u0430\u0454\u0442\u044C\u0441\u044F \u0437 \u043A\u0440\u0430\u0431\u0456\u0432,
      \u0430 \u043A\u043E\u0436\u043D\u0430 \u043D\u0430\u0441\u0442\u0443\u043F\u043D\u0430
      \u043B\u0430\u043D\u043A\u0430 \u043C\u043E\u0436\u0435 \u0437'\u0457\u0441\u0442\u0438
      \u043F\u043E\u043F\u0435\u0440\u0435\u0434\u043D\u044E \u0456\u0441\u0442\u043E\u0442\u0443
      \u0430\u0431\u043E \u0436 \u0441\u043E\u0431\u0456 \u043F\u043E\u0434\u0456\u0431\u043D\u0443.
      \n\t<u>\u0407\u0441\u0442\u0438 \u0440\u0438\u0431\u0443 \u0441\u0432\u043E\u0433\u043E
      \u0432\u0438\u0434\u0443 \u043C\u043E\u0436\u043D\u0430 \u043B\u0438\u0448\u0435
      \u043A\u043E\u043B\u0438 \u0432\u043E\u043D\u0430 \u043C\u0435\u043D\u0448\u0430
      \u0437\u0430 \u0440\u043E\u0437\u043C\u0456\u0440\u043E\u043C; \u0430 \u0437
      \u043A\u043E\u0436\u043D\u0438\u043C \u0440\u0456\u0432\u043D\u0435\u043C \u0432\u043B\u0430\u0441\u043D\u043E\u0433\u043E
      \u0440\u043E\u0441\u0442\u0443 \u2014 \u0441\u043B\u0430\u0431\u0448\u0456
      \u0440\u0438\u0431\u0438 \u043D\u0435 \u0437'\u044F\u0432\u043B\u044F\u0442\u0438\u043C\u0443\u0442\u044C\u0441\u044F.</u>"
    m_Metadata:
      m_Items: []
