  - m_Id: 6543585603584
    m_Localized: "\u0422\u0438\u0433\u0440\u043E\u0432\u0430 \u0410\u043A\u0443\u043B\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 6639551279104
    m_Localized: "\u0410\u043A\u0443\u043B\u0430-\u041C\u043E\u043B\u043E\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 6901120659456
    m_Localized: "\u0422\u0443\u043D\u0435\u0446\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 6972407050240
    m_Localized: "\u0411\u0430\u0440\u0430\u043A\u0443\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 46112922169344
    m_Localized: "\t\u041F\u0456\u0434 \u0447\u0430\u0441 \u0434\u043E\u0441\u043B\u0456\u0434\u0436\u0435\u043D\u043D\u044F
      \u043C\u043E\u0440\u0441\u044C\u043A\u043E\u0433\u043E \u0434\u043D\u0430 \u0432\u0438
      \u043C\u043E\u0436\u0435\u0442\u0435 \u043D\u0430\u0442\u0440\u0430\u043F\u0438\u0442\u0438
      \u043D\u0430 \u0440\u0456\u0437\u043D\u043E\u043C\u0430\u043D\u0456\u0442\u043D\u0456
      \u043C\u0456\u0441\u0446\u044F \u0442\u0430 \u043E\u0431'\u0454\u043A\u0442\u0438,
      \u0449\u043E \u043D\u0430\u0434\u0430\u044E\u0442\u044C \u0432\u0430\u0448\u0456\u0439
      \u0440\u0438\u0431\u0456 \u043F\u0435\u0432\u043D\u0438\u0439 \u0435\u0444\u0435\u043A\u0442.
      \u0412\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0439\u0442\u0435
      \u0457\u0445 \u0434\u043B\u044F \u0437\u0431\u0456\u043B\u044C\u0448\u0435\u043D\u043D\u044F
      \u0448\u0430\u043D\u0441\u0456\u0432 \u043D\u0430 \u0432\u0430\u0448\u0435
      \u0432\u0438\u0436\u0438\u0432\u0430\u043D\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 46567152709632
    m_Localized: "\t<u>\u041E\u0434\u043D\u0430\u043A \u0432\u0440\u0430\u0445\u043E\u0432\u0443\u0439\u0442\u0435,
      \u0449\u043E \u0435\u0444\u0435\u043A\u0442\u0438 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0456
      \u0439 \u0432\u043E\u0440\u043E\u0433\u0430\u043C.</u>"
    m_Metadata:
      m_Items: []
  - m_Id: 47032749813760
    m_Localized: "\t\u0412\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u043D\u043E
      \u043A\u043E\u0436\u043D\u043E\u0433\u043E \u0432\u0430\u0448\u043E\u0433\u043E
      \u0440\u0456\u0432\u043D\u044F, \u043C\u0430\u043F\u0430 \u0441\u0442\u0432\u043E\u0440\u044E\u0432\u0430\u0442\u0438\u043C\u0435
      \u0432\u043E\u0440\u043E\u0433\u0456\u0432 \u043D\u0430 \u0440\u0456\u0432\u0435\u043D\u044C
      \u0441\u043B\u0430\u0431\u0448\u0435, \u0440\u0456\u0432\u0435\u043D\u044C
      \u0432\u0430\u0436\u0447\u0435 \u0442\u0430 \u0432\u043E\u0440\u043E\u0433\u0456\u0432
      \u0432\u0430\u0448\u043E\u0433\u043E \u0440\u0456\u0432\u043D\u044F. "
    m_Metadata:
      m_Items: []
  - m_Id: 48092990173184
    m_Localized: "\t\u0411\u0443\u0434\u044C\u0442\u0435 \u043E\u0431\u0435\u0440\u0435\u0436\u043D\u0456
      \u043F\u0456\u0434 \u0447\u0430\u0441 \u043F\u0435\u0440\u0435\u0432\u0442\u0456\u043B\u0435\u043D\u043D\u044F
      \u0432 \u0430\u043A\u0443\u043B\u0443, \u043E\u0441\u043A\u0456\u043B\u044C\u043A\u0438
      \u0432\u0441\u0456 \u0430\u043A\u0443\u043B\u0438 \u0430\u0442\u0430\u043A\u0443\u044E\u0442\u044C
      \u0441\u043E\u0431\u0456 \u043F\u043E\u0434\u0456\u0431\u043D\u0438\u0445 \u043D\u0430\u0432\u0456\u0442\u044C
      \u0437 \u043E\u0434\u043D\u0430\u043A\u043E\u0432\u0438\u043C \u0440\u0456\u0432\u043D\u0435\u043C.
      \u0422\u043E\u0436 \u044F\u043A\u0449\u043E \u0432\u0438 \u0437\u0430\u043D\u0430\u0434\u0442\u043E
      \u0434\u043E\u0432\u0433\u043E \u0437\u0432\u043E\u043B\u0456\u043A\u0430\u0454\u0442\u0435
      \u0437 \u0432\u043B\u0430\u0441\u043D\u043E\u044E \u0442\u0440\u0430\u043F\u0435\u0437\u043E\u044E,
      \u0434\u0435\u0441\u044C \u0443 \u0433\u043B\u0438\u0431\u0438\u043D\u0430\u0445
      \u043C\u043E\u0440\u044F \u0437\u0430\u0447\u0430\u0457\u0432\u0441\u044F <u><color=red>\u043C\u043E\u043D\u0441\u0442\u0440</color=red></u>,
      \u043A\u043E\u0442\u0440\u0438\u0439 \u0437'\u0457\u0432 \u0443\u0441\u0456\u0445
      \u0441\u0432\u043E\u0457\u0445 \u0434\u0440\u0443\u0437\u0456\u0432 \u0456
      \u0442\u0435\u043F\u0435\u0440 \u0447\u0435\u043A\u0430\u0454 \u043D\u0430
      \u0432\u0430\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 52080728895488
    m_Localized: "\t\u041A\u043E\u043B\u0438 \u0432\u0430\u0436\u043A\u043E \u0437\u0440\u043E\u0437\u0443\u043C\u0456\u0442\u0438,
      \u0447\u0438 \u043C\u043E\u0436\u0435\u0442\u0435 \u0432\u0438 \u0437'\u0457\u0441\u0442\u0438
      \u0432\u043E\u0440\u043E\u0433\u0430 \u0442\u043E\u0433\u043E \u0436 \u0440\u0456\u0432\u043D\u044F,
      \u043A\u043E\u0440\u0438\u0441\u0442\u0443\u0439\u0442\u0435\u0441\u044F \u043F\u0456\u0434\u043A\u0430\u0437\u043A\u0430\u043C\u0438
      \xAB\u0414\u0435\u0442\u0435\u043A\u0442\u043E\u0440\u0430 \u0412\u043E\u0440\u043E\u0433\u0430\xBB
      \u0443 \u0432\u0438\u0433\u043B\u044F\u0434\u0456 \u0447\u0435\u0440\u0432\u043E\u043D\u043E\u0457
      \u0441\u0442\u0440\u0456\u043B\u043A\u0438 \u043D\u0430\u0434 \u0432\u0430\u043C\u0438.
      \u042F\u043A\u0449\u043E \u0432\u0438 \u0457\u0457 \u0431\u0430\u0447\u0438\u0442\u0435,
      \u0442\u043E \u0445\u0430\u043F\u0430\u0439\u0442\u0435 \u043B\u0430\u0441\u0442\u0438
      \u0432 \u0440\u0443\u043A\u0438 \u0439 \u0442\u0456\u043A\u0430\u0439\u0442\u0435
      \u0443 \u043F\u0440\u043E\u0442\u0438\u043B\u0435\u0436\u043D\u043E\u043C\u0443
      \u043D\u0430\u043F\u0440\u044F\u043C\u043A\u0443!"
    m_Metadata:
      m_Items: []
  - m_Id: 52108457439232
    m_Localized: "\u0414\u0435\u0442\u0435\u043A\u0442\u043E\u0440 \u0412\u043E\u0440\u043E\u0433\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 52339894939648
    m_Localized: "\t\u0414\u043B\u044F \u043A\u0435\u0440\u0443\u0432\u0430\u043D\u043D\u044F
      \u0441\u043E\u0431\u043E\u044E, \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0439
      \u0434\u0436\u043E\u0439\u0441\u0442\u0438\u043A \u0442\u0430 \u043A\u043D\u043E\u043F\u043A\u0443
      \u043F\u0440\u0438\u0441\u043A\u043E\u0440\u0435\u043D\u043D\u044F, \u044F\u043A\u0456
      \u0432\u0438 \u043C\u043E\u0436\u0435\u0442\u0435 \u043D\u0430\u0442\u0438\u0441\u043A\u0430\u0442\u0438
      \u0441\u0432\u043E\u0457\u043C\u0438 \u0440\u0443\u043A\u0430\u043C\u0438,
      \u043D\u0443 \u0430\u0431\u043E \u0436 \u0456\u043D\u0448\u0438\u043C\u0438
      \u0412\u043E\u0414\u041D\u0438\u041C\u0438 \u041F\u0440\u0438\u0421\u0422\u043E\u0421\u0443\u0412\u0430\u043D\u043D\u044F\u043C\u0438)."
    m_Metadata:
      m_Items: []
  - m_Id: 55301539131392
    m_Localized: "\t\u0414\u043B\u044F \u043A\u0440\u0430\u0449\u043E\u0457 \u043E\u0440\u0456\u0454\u043D\u0442\u0430\u0446\u0456\u0457
      \u0432 \u043F\u0440\u043E\u0441\u0442\u043E\u0440\u0456 \u0442\u0430 \u0432\u0438\u044F\u0432\u043B\u0435\u043D\u043D\u044F
      \u0432\u043E\u0440\u043E\u0433\u0456\u0432 \u043F\u0456\u0434 \u0447\u0430\u0441
      \u043F\u043B\u0430\u0432\u0430\u043D\u043D\u044F \u0432 \u0442\u0435\u0447\u0456\u0457
      \u043D\u0435\u043E\u0431\u0445\u0456\u0434\u043D\u043E \u0440\u0443\u0445\u0430\u0442\u0438\u0441\u044F
      \u0445\u0432\u0438\u043B\u0435\u043F\u043E\u0434\u0456\u0431\u043D\u0438\u043C
      \u043D\u0430\u043F\u0440\u044F\u043C\u043A\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 56455538962432
    m_Localized: "\t\u042F\u043A\u0449\u043E \u0432\u0438 \u0437\u0430\u0431\u0443\u043B\u0438
      \u044F\u043A \u0433\u0440\u0430\u0442\u0438 \u2013 \u043F\u0456\u0434\u0456\u0439\u0434\u0456\u0442\u044C
      \u0434\u043E \u043A\u0440\u0430\u0431\u0456\u0432 \u044F\u043A\u043E\u043C\u043E\u0433\u0430
      \u0431\u043B\u0438\u0436\u0447\u0435 \u0434\u043B\u044F \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0442\u0438\u0432\u043D\u043E\u0433\u043E
      \u0434\u0456\u0430\u043B\u043E\u0433\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 9502929981042688
    m_Localized: "\t\u0414\u0435\u044F\u043A\u0456 \u0437 \u043E\u0431'\u0454\u043A\u0442\u0456\u0432
      \u0437\u0434\u0430\u0442\u043D\u0456 \u043E\u043D\u043E\u0432\u043B\u044E\u0432\u0430\u0442\u0438
      \u0447\u0438 \u043F\u043E\u043A\u0440\u0430\u0449\u0443\u0432\u0430\u0442\u0438
      \u0432\u0430\u0448\u0456 \u043F\u043E\u043A\u0430\u0437\u043D\u0438\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 9509788720852992
    m_Localized: "\t\u041F\u0435\u0440\u0435\u0434 \u0437\u0430\u043D\u0443\u0440\u0435\u043D\u043D\u044F\u043C
      \u0443 \u043C\u043E\u0440\u0441\u044C\u043A\u0456 \u043F\u0440\u0438\u0433\u043E\u0434\u0438
      , \u043F\u043E\u043F\u0435\u0440\u0435\u0434\u0436\u0430\u044E \u0432\u0430\u0441:
      \u0441\u0442\u0435\u0440\u0435\u0436\u0456\u0442\u044C\u0441\u044F \u043F\u0456\u0434\u0432\u043E\u0434\u043D\u043E\u0433\u043E
      \u0431\u0443\u043D\u0442\u0456\u0432\u043D\u0438\u043A\u0430 \u0420\u0438\u0431\u0438-\u0444\u0443\u0433\u0443
      \u0442\u0430 \u041A\u0430\u0440\u0430\u043A\u0430\u0442\u0438\u0446\u0456!"
    m_Metadata:
      m_Items: []
