    m_Metadata:
      m_Items: []
  - m_Id: 649093866614784
    m_Localized: "\u0411\u0443\u043B\u044C\u043A\u043E\u0429\u0438\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 649204814344192
    m_Localized: "\u0406\u043C\u0443\u043D\u0456\u0442\u0435\u0442 \u0434\u043E \u043E\u0442\u0440\u0443\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 649644339654656
    m_Localized: "\u0410\u0433\u0440\u0435\u0441\u0438\u0432\u043D\u0456\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 652004738756608
    m_Localized: "\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 652046442721280
    m_Localized: "\u043C/\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 652095302168576
    m_Localized: "\u043E\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 661301455515648
    m_Localized: "\u041D\u0430 \u0446\u0456\u0439 \u0440\u0438\u0431\u0456 \u0442\u0440\u0438\u043C\u0430\u0454\u0442\u044C\u0441\u044F
      \u0432\u0441\u044F \u0435\u043A\u043E\u0441\u0438\u0441\u0442\u0435\u043C\u0430.
      \u0417\u0443\u0441\u0442\u0440\u0456\u0447\u0430\u0454\u0442\u044C\u0441\u044F
      \u0434\u0443\u0436\u0435 \u0447\u0430\u0441\u0442\u043E \u0456 \u0432 \u043A\u043E\u0436\u043D\u043E\u043C\u0443
      \u0431\u0456\u043E\u043C\u0456. \u0412\u0456\u0434\u043D\u043E\u0441\u043D\u043E
      \u0448\u0432\u0438\u0434\u043A\u0430 \u0430\u043B\u0435 \u0432\u043E\u0434\u043D\u043E\u0447\u0430\u0441
      \u0434\u043E\u0441\u0438\u0442\u044C \u0441\u043B\u0430\u0431\u043A\u0430.
      \u0427\u0443\u0434\u043E\u0432\u0438\u0439 \u043F\u0435\u0440\u0435\u043A\u0443\u0441
      \u0434\u043B\u044F \u043F\u043E\u0447\u0430\u0442\u043A\u043E\u0432\u0438\u0445
      \u0440\u0456\u0432\u043D\u0456\u0432 \u043F\u0440\u043E\u0433\u0440\u0435\u0441\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 661422603792384
    m_Localized: "\u0421\u043F\u043E\u0447\u0430\u0442\u043A\u0443 \u0431\u0443\u043B\u043E
      \u0441\u043B\u043E\u0432\u043E, \u043F\u043E\u0442\u0456\u043C \u0437'\u044F\u0432\u0438\u0432\u0441\u044F
      \u043A\u0440\u0430\u0431, \u0430 \u043F\u043E\u0442\u0456\u043C \u0432\u0435\u0441\u044C
      \u0441\u0432\u0456\u0442 \u0441\u0442\u0432\u043E\u0440\u0438\u0432\u0441\u044F
      \u043D\u0430\u0432\u043A\u043E\u043B\u043E \u043D\u044C\u043E\u0433\u043E.
      \u041F\u043E\u0432\u0456\u043B\u044C\u043D\u0438\u0439, \u043F\u043E\u0436\u0438\u0432\u043D\u0438\u0439,
      \u0431\u0435\u0437\u0437\u0430\u0445\u0438\u0441\u043D\u0438\u0439 \u0430\u043B\u0435
      \u0434\u0443\u0443\u0443\u0436\u0435 \u0441\u043C\u0430\u0447\u043D\u0438\u0439
      \u043D\u0430\u0439\u043A\u0440\u0430\u0449\u0438\u0439 \u0434\u0440\u0443\u0433
      \u0433\u0440\u0430\u0432\u0446\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 661465922564096
    m_Localized: "\u041C\u0430\u043B\u0430, \u043C\u0430\u043D\u0435\u0432\u0440\u0435\u043D\u0430
      \u0442\u0430 \u0434\u043E\u0441\u0438\u0442\u044C \u043F\u043E\u0432\u0456\u043B\u044C\u043D\u0430
      \u0440\u0438\u0431\u043A\u0430, \u0449\u043E \u0442\u0440\u0430\u043F\u043B\u044F\u0454\u0442\u044C\u0441\u044F
      \u0432 \u0431\u043E\u0456\u043C\u0430\u0445 \u043A\u043E\u0440\u0430\u043B\u043E\u0432\u0438\u0445
      \u0441\u043A\u0435\u043B\u044C \u0442\u0430 \u043F\u0440\u0438\u0433\u0440\u0430\u043D\u0438\u0447\u043D\u0438\u0445
      \u0432\u043E\u0434\u043E\u0440\u043E\u0441\u0442\u044F\u043D\u0438\u0445 \u043B\u0456\u0441\u0456\u0432.
      \u041C\u0430\u0454 \u044F\u0441\u043A\u0440\u0430\u0432\u0435 \u0437\u0430\u0431\u0430\u0440\u0432\u043B\u0435\u043D\u043D\u044F,
      \u0430\u043B\u0435 \u0446\u0435 \u0433\u0440\u0430\u0454 \u043B\u0438\u0448\u0435
      \u043D\u0430 \u043A\u043E\u0440\u0438\u0441\u0442\u044C \u0432\u043E\u0440\u043E\u0433\u0430\u043C.
      \u0411\u0443\u0442\u0438 \u0446\u0456\u0454\u044E \u0440\u0438\u0431\u043A\u043E\u044E
      \u0434\u043E\u0432\u0433\u043E \u043D\u0435 \u0432\u0430\u0440\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 661505349021696
    m_Localized: "\u041D\u0430\u0439\u043F\u0435\u0440\u0448\u0438\u0439 \u0441\u0435\u0440\u0439\u043E\u0437\u043D\u0438\u0439
      \u0445\u0438\u0436\u0430\u043A \u0443 \u0433\u0440\u0456. \u041F\u0440\u043E\u0434\u043E\u0432\u0433\u0443\u0432\u0430\u0442\u0435
      \u0442\u0456\u043B\u043E \u0442\u0430 \u043C\u0430\u0441\u043A\u0443\u0432\u0430\u043D\u043D\u044F
      \u0434\u043E\u0437\u0432\u043E\u043B\u044F\u0454 \u043A\u0440\u0430\u0449\u0435
      \u043F\u043E\u043B\u044E\u0432\u0430\u0442\u0438 \u043D\u0430 \u0432\u0456\u0434\u043A\u0440\u0438\u0442\u0438\u0445
      \u0432\u043E\u0434\u043D\u0438\u0445 \u043F\u043B\u043E\u0449\u0430\u0445.
      \u041E\u0434\u043D\u0430\u043A \u0456\u043D\u0442\u0435\u043B\u0435\u043A\u0442\u043E\u043C
      \u0446\u044C\u043E\u0433\u043E \u0445\u0438\u0436\u0430\u043A\u0430 - \u043F\u0440\u0438\u0440\u043E\u0434\u0430
      \u043D\u0435 \u043D\u0430\u0434\u0456\u043B\u0438\u043B\u0430. \u041B\u0435\u0433\u043A\u043E
      \u043E\u0431\u0434\u0443\u0440\u0438\u0442\u0438 \u043F\u0456\u0434 \u0447\u0430\u0441
      \u0432\u0442\u0435\u0447\u0456 \u043F\u043E\u043F\u0456\u0434 \u043A\u0430\u043C'\u044F\u043D\u0438\u043C\u0438
      \u0431\u0440\u0438\u043B\u0430\u043C\u0438. \u0420\u0438\u0431\u0430   \u044F\u043A\u0443
      \u0432\u0441\u0456 \u043D\u0430\u0439\u0431\u0456\u043B\u044C\u0448\u0435 \u043E\u0431\u043E\u0436\u043D\u044E\u044E\u0442\u044C
      \u0432 \u043D\u0430\u0432\u0430\u0436\u0447\u043E\u043C\u0443 \u0440\u0435\u0436\u0438\u043C\u0456
      \u0433\u0440\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 661536483340288
    m_Localized: "\u041E\u0434\u043D\u0430 \u0437 \u043D\u0430\u0439\u043F\u043E\u0432\u0456\u043B\u044C\u043D\u0456\u0448\u0438\u0445,
      \u043D\u0430\u0439\u0434\u043E\u0432\u0448\u0438\u0445 \u0442\u0430 \u043D\u0430\u0439\u0436\u043E\u0432\u0442\u0443\u0432\u0430\u0442\u0456\u0448\u0438\u0445
      \u0440\u0438\u0431. \u0423\u043F\u0440\u0430\u0432\u043B\u044F\u0442\u0438
      \u0442\u0430\u043A\u043E\u044E \u0440\u0438\u0431\u043E\u044E - \u0432\u0441\u0435
      \u043E\u0434\u043D\u043E \u0449\u043E \u043A\u0435\u0440\u043C\u0443\u0432\u0430\u0442\u0438
      \u043B\u0456\u0442\u0430\u043A \u0456\u0437 \u0437\u0430\u043A\u0440\u0438\u0442\u0438\u043C\u0438
      \u043E\u0447\u0438\u043C\u0430. \u041D\u0430\u0439\u0447\u0430\u0441\u0442\u0456\u0448\u0435
      \u0442\u0440\u0430\u043F\u043B\u044F\u0454\u0442\u044C\u0441\u044F \u0432 \u0432\u043E\u0434\u043E\u0440\u043E\u0441\u0442\u044F\u043D\u0438\u0445
      \u043B\u0456\u0441\u0430\u0445. \u041C\u0430\u0454 \u0432\u0435\u043B\u0438\u043A\u0438\u0445
      \u0440\u0430\u0434\u0456\u0443\u0441 \u0443\u043A\u0443\u0441\u0443, \u0449\u043E
      \u043C\u043E\u0436\u0435 \u0434\u043E\u043F\u043E\u043C\u0433\u0442\u0438 \u043F\u0440\u0438
      \u0448\u0432\u0438\u0434\u043A\u043E\u043C\u0443 \u043F\u043E\u0457\u0434\u0430\u043D\u043D\u0456
      \u043E\u0431'\u0454\u043A\u0442\u0456\u0432 \u043D\u0430\u0432\u043A\u043E\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 661567122731008
    m_Localized: "\u0421\u043F\u0440\u0430\u0432\u0436\u043D\u0456\u0439 \u043D\u0435\u043F\u043E\u043C\u0456\u0442\u043D\u0438\u0439
      \u0432\u0431\u0438\u0432\u0446\u044F. \u041C\u0430\u043B\u0430, \u0448\u0432\u0438\u0434\u043A\u0430
      \u0456 \u0434\u0443\u0436\u0435 \u043C\u0430\u043D\u0435\u0432\u0440\u0435\u043D\u0430
      \u0440\u0438\u0431\u0430 \u0437 \u0434\u043E\u0441\u0438\u0442\u044C \u043D\u0435\u0432\u0435\u043B\u0438\u043A\u0438\u043C
      \u0437\u0430\u043F\u0430\u0441\u043E\u043C \u0436\u0438\u0442\u0442\u044F.
      \u0414\u0443\u0436\u0435 \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0430
      \u0440\u0438\u0431\u0430, \u0445\u0442\u043E \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044E\u0454
      \u0457\u0457, \u0442\u043E\u0439 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044E\u0454
      \u043F\u0456\u0432 \u043E\u043A\u0435\u0430\u043D\u0443. \u041F\u0440\u0438\u0440\u043E\u0434\u0430
      \u043D\u0430\u0434\u0456\u043B\u0438\u043B\u0430 \u0457\u0457 \u043E\u0442\u0440\u0443\u0442\u043E\u044E
      \u0442\u0430 \u0456\u043C\u0443\u043D\u0456\u0442\u0435\u0442\u043E\u043C \u0434\u043E
      \u043D\u0435\u0457, \u043E\u0434\u043D\u0430\u043A \u0446\u044F \u0433\u0440\u0430
      - \u043D\u0435 \u043F\u0440\u0438\u0440\u043E\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 661598261243904
    m_Localized: "\u0422\u0438\u0445\u0438\u0439, \u043F\u043E\u0432\u0456\u043B\u044C\u043D\u0438\u0439
      \u0442\u0430\u043D\u043A,  \u0430\u043B\u0435 \u0431\u0440\u043E\u043D\u0435\u0431\u0456\u0439\u043D\u0438\u0439.
      \u042F\u043A \u0431\u0438 \u0448\u0432\u0438\u0434\u043A\u043E \u0442\u0430
      \u0434\u0430\u043B\u0435\u043A\u043E \u041F\u0442\u0435\u0440\u043E\u0457\u0441
      \u043D\u0435 \u0442\u0456\u043A\u0430\u043B\u0430 - \u0440\u0430\u043D\u043E
      \u0447\u0438 \u043F\u0456\u0437\u043D\u043E \u0446\u0435\u0439 \u0445\u0438\u0436\u0430\u043A
      \u0457\u0457 \u043D\u0430\u0437\u0434\u043E\u0436\u0435\u043D\u0435 \u0442\u0430
      \u0437'\u0457\u0441\u0442\u044C. \u0427\u0430\u0441\u0442\u043E \u043F\u043B\u0430\u0432\u0430\u0454
      \u043F\u043E\u043F\u0456\u0434 \u0441\u043A\u0435\u043B\u044F\u043D\u0438\u043C\u0438
      \u0443\u0449\u0435\u043B\u0435\u043D\u0430\u043C\u0438, \u043B\u044E\u0431\u0438\u0442\u044C
      \u0441\u0430\u043C\u043E\u0442\u043D\u0456\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 661625301921792
    m_Localized: "\u041D\u0430\u0439\u0448\u0432\u0438\u0434\u0448\u0438\u0439 \u0442\u0430
      \u043E\u0434\u0438\u043D \u0437 \u043D\u0430\u0439\u0431\u0456\u043B\u044C\u0448
      \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0438\u0445 \u0445\u0438\u0436\u0430\u043A\u0456\u0432.
      \u0414\u0443\u0436\u0435 \u043D\u0435\u043F\u0435\u0440\u0435\u0434\u0431\u0430\u0447\u0443\u0432\u0430\u043D\u0438\u0439,
      \u043F\u043E\u043A\u0438 \u0432\u0438 \u0431\u0443\u0434\u0435\u0442\u0435
      \u043F\u043B\u0430\u043D\u0443\u0432\u0430\u0442\u0438 \u044F\u043A \u0432\u0442\u0435\u043A\u0442\u0438,
      \u0432\u0456\u043D \u0432\u0436\u0435 \u0434\u043E\u0457\u0434\u0430\u0442\u0438\u043C\u0435
      \u0432\u0430\u0448\u0456 \u0437\u0430\u043B\u0438\u0448\u043A\u0438. \u0420\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u0454\u0442\u044C\u0441\u044F
      \u0432\u0456\u0434\u0441\u043B\u0456\u0434\u043A\u043E\u0432\u0443\u0432\u0430\u0442\u0438
      \u0437\u0430 \u0442\u0456\u043D\u044F\u043C\u0438 \u043D\u0430 \u043F\u0456\u0434\u0432\u043E\u0434\u043D\u0456\u0439
      \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u0456, \u0449\u043E\u0431 \u0432\u0442\u0435\u043A\u0442\u0438
      \u0434\u043E \u0442\u043E\u0433\u043E, \u044F\u043A \u0432\u0456\u043D \u0432\u0430\u0441
      \u043F\u043E\u0431\u0430\u0447\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 661637779976192
    m_Localized: "\u041B\u0456\u043D\u0438\u0432\u0430 \u0441\u043F\u0440\u043E\u0431\u0430
      \u043F\u0435\u0440\u0435\u043F\u0443\u0441\u0442\u043A\u0438 \u0434\u043E \u043A\u043B\u0430\u0441\u0443
      \u0430\u043A\u0443\u043B. \u041D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0438\u0439
      \u0434\u043B\u044F \u0432\u0441\u044C\u043E\u0433\u043E \u0445\u0430\u0440\u0447\u043E\u0432\u043E\u0433\u043E
      \u043B\u0430\u043D\u0446\u044E\u0433\u0430 \u0433\u0440\u0438 \u043D\u0438\u0449\u0435
      \u0437\u0430 \u0441\u0435\u0431\u0435. \u041E\u0434\u043D\u0430\u043A \u0437
      \u0456\u043D\u0448\u043E\u0457 \u0441\u0442\u043E\u0440\u043E\u043D\u0438 \u0432\u043C\u0435\u0440\u0442\u0438
      \u0432\u0456\u0434 \u043E\u0441\u043E\u0431\u0438\u043D\u0438 \u0441\u0432\u043E\u0433\u043E
      \u0440\u043E\u0434\u0443 \u0434\u043B\u044F \u0446\u0456\u0454\u0457 \u0440\u0438\u0431\u0438
      - \u0437\u0432\u0438\u0447\u043D\u0430 \u0441\u043F\u0440\u0430\u0432\u0430.
      \u0422\u0440\u0430\u043F\u043B\u044F\u0454\u0442\u044C\u0441\u044F \u0432 \u0431\u0456\u043E\u043C\u0430\u0445
      \u0433\u043B\u0438\u0431\u0438\u043D\u043D\u0438\u0445 \u043A\u043E\u0440\u0430\u043B\u0456\u0432
      \u0442\u0430 \u043B\u0430\u0442\u0430\u0442\u0442\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 661729958195200
    m_Localized: "\u0421\u0435\u0440\u0435\u0434 \u043A\u043B\u0430\u0441\u0443 \u0430\u043A\u0443\u043B
      - \u0434\u0440\u0443\u0433\u0438\u0439 \u0437\u0430 \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0456\u0441\u0442\u044E.
      \u0428\u0432\u0438\u0434\u043A\u0438\u0439, \u0430\u0433\u0440\u0435\u0441\u0438\u0432\u043D\u0438\u0439
      \u0442\u0430 \u043C\u0430\u0439\u0436\u0435 \u043D\u0435\u0432\u0438\u0434\u0438\u043C\u0438\u0439.
      \u0411\u0430\u0447\u0430\u0447\u0438 \u043E\u0442\u0440\u0443\u0439\u043D\u0443
      \u043C\u0435\u0434\u0443\u0437\u0443, \u0446\u044F \u0430\u043A\u0443\u043B\u0430
      \u0431\u0443\u0434\u0435 \u0431\u0435\u0437 \u0432\u0430\u0433\u0430\u043D\u044C
      \u0456\u0442\u0438 \u043D\u0430 \u043F\u0440\u043E\u043B\u043E\u043C. \u0407\u0441\u0442\u044C
      \u043C\u0430\u0439\u0436\u0435 \u0432\u0441\u0435 \u0449\u043E \u0431\u0430\u0447\u0438\u0442\u044C,
      \u0456\u043D\u043E\u0434\u0456 \u0446\u0435 \u0444\u0430\u0442\u0430\u043B\u044C\u043D\u0438\u0439
      \u0432\u0438\u0431\u0456\u0440 \u0432 \u0439\u043E\u0433\u043E \u0436\u0438\u0442\u0442\u0456,
      \u0430\u043B\u0435 \u0437\u0430\u0432\u0434\u044F\u043A\u0438 \u0446\u044C\u043E\u043C\u0443
      \u0432\u0438\u0431\u043E\u0440\u0443 \u0432\u0456\u043D \u0432\u0441\u0435
      \u0449\u0435 \u0436\u0438\u0432\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 661748178251776
    m_Localized: "\u042F\u043A\u0449\u043E \u0432 \u0433\u043B\u0438\u0431\u0438\u043D\u0430\u0445
      \u043E\u043A\u0435\u0430\u043D\u0443 \u0454 \u043F\u0440\u043E\u044F\u0432
      \u0431\u0435\u0437\u043C\u0435\u0436\u043D\u043E\u0457 \u0441\u0438\u043B\u0438,
      \u0442\u043E \u0432\u0456\u043D \u043F\u0435\u0440\u0435\u0434 \u0432\u0430\u043C\u0438.
      \u041D\u0435\u043F\u0435\u0440\u0435\u043C\u043E\u0436\u043D\u0438\u0439 \u0445\u0438\u0436\u0430\u043A,
      \u0432\u0430\u0436\u043A\u0438\u0439, \u0432\u0435\u043B\u0438\u043A\u0438\u0439,
      \u043A\u0440\u043E\u0432\u043E\u0436\u0435\u0440\u043B\u0438\u0432\u0438\u0439
      \u0442\u0430 \u043C\u0430\u0439\u0436\u0435 \u0431\u0456\u043B\u0438\u0439.
      \u041D\u0430\u0439\u0432\u0438\u0449\u0430 \u043B\u0430\u043D\u043A\u0430 \u0445\u0430\u0440\u0447\u043E\u0432\u043E\u0433\u043E
      \u043B\u0430\u043D\u0446\u044E\u0433\u0430 \u0433\u0440\u0438, \u043C\u043E\u0436\u0435
      \u0432\u0438\u0440\u043E\u0441\u0442\u0430\u0442\u0438 \u0434\u043E \u043D\u0430\u0434\u0437\u0432\u0438\u0447\u0430\u0439\u043D\u043E
      \u0432\u0435\u043B\u0438\u043A\u0438\u0445 \u0440\u043E\u0437\u043C\u0456\u0440\u0456\u0432
      \u043F\u043E\u0440\u0456\u0432\u043D\u044F\u043D\u043E \u0437 \u0443\u0441\u0456\u043C\u0430
      \u0456\u043D\u0448\u0438\u043C\u0438 \u0430\u043A\u0443\u043B\u0430\u043C\u0438.
      \u041D\u0435 \u043C\u0430\u0454 \u043C\u0435\u0436 \u043F\u0440\u043E\u0433\u0440\u0435\u0441\u0443.
      \u042F\u043A\u0449\u043E \u043F\u043E\u0431\u0430\u0447\u0438\u043B\u0438 \u0439\u043E\u0433\u043E,
      \u0442\u043E \u043C\u043E\u0436\u0435\u0442\u0435 \u0432\u0436\u0435 \u043D\u0435
      \u0442\u0456\u043A\u0430\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 661763097391104
    m_Localized: "\u0429\u043E \u0437\u0430 \u043D\u0435\u043F\u0440\u0438\u0454\u043C\u043D\u0438\u0439
      \u0441\u0432\u0438\u0441\u0442? \u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E!
      \u0426\u0435 \u043C\u0430\u0439\u0436\u0435 \u043D\u0435\u043F\u0435\u0440\u0435\u043C\u043E\u0436\u043D\u0430
      \u043D\u0430\u0434\u0443\u0432\u043D\u0430 \u043A\u0443\u043B\u044C\u043A\u0430
      \u043E\u0431\u043B\u0456\u043F\u043B\u0435\u043D\u0430 \u0437 \u0443\u0441\u0456\u0445
      \u0441\u0442\u043E\u0440\u0456\u043D \u0448\u0438\u043F\u0430\u043C\u0438.
      \u0428\u0432\u0438\u0434\u043A\u0438\u0439, \u043D\u0430\u0434\u043E\u043A\u0443\u0447\u043B\u0438\u0432\u0438\u0439,
      \u043E\u0434\u043D\u0430\u043A \u0434\u0443\u0443\u0443\u0436\u0435 \u043B\u044E\u0431\u0438\u0442\u044C
      \u043E\u0431\u0456\u0439\u043C\u0438, \u044F\u043A\u0449\u043E \u0432\u0438
      \u0442\u0435\u0436, \u0442\u043E \u0432\u0456\u043D \u0432\u0430\u0441 \u0447\u0435\u043A\u0430\u0454.
      \u0422\u0440\u0430\u043F\u043B\u044F\u0454\u0442\u044C\u0441\u044F \u0432 \u043A\u043E\u0436\u043D\u043E\u043C\u0443
      \u0431\u0456\u043E\u043C\u0456 \u0433\u0440\u0438. \u041F\u0456\u0434 \u0447\u0430\u0441
      \u0440\u043E\u0437\u0434\u0443\u0432\u0430\u043D\u043D\u044F - \u0448\u043A\u043E\u0434\u0430
      \u0432\u0456\u0434 \u0439\u043E\u0433\u043E \u0448\u0438\u043F\u0456\u0432
      \u043F\u0456\u0434\u0456\u0439\u043C\u0430\u0454\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 661777437716480
    m_Localized: "\u0413\u043E\u043B\u043E\u0432\u043E\u043D\u043E\u0433\u0438\u0439
      \u043C\u043E\u043B\u044E\u0441\u043A, \u0449\u043E \u043D\u0435 \u0437\u0440\u043E\u0437\u0443\u043C\u0456\u043B\u043E
      \u044F\u043A \u0441\u044E\u0434\u0438 \u043F\u043E\u0442\u0440\u0430\u043F\u0438\u0432.
      \u0406\u0441\u043D\u0443\u0454 \u043B\u0438\u0448\u0435 \u0432 \u0431\u0456\u043E\u043C\u0456
      \u0433\u043B\u0438\u0431\u0438\u043D\u043D\u0438\u0445 \u043A\u043E\u0440\u0430\u043B\u0456\u0432,
      \u0445\u043E\u0447 \u0456\u043D\u043E\u0434\u0456 \u0432\u0438\u043F\u043B\u0438\u0432\u0430\u0454
      \u0437\u0430 \u0439\u043E\u0433\u043E \u043C\u0435\u0436\u0456. \u041F\u0440\u0438
      \u043D\u0430\u0431\u043B\u0438\u0436\u0435\u043D\u043D\u0456 \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u043A\u0438
      - \u0432\u0438\u043F\u0443\u0441\u043A\u0430\u0454 \u043E\u0442\u0440\u0443\u0439\u043D\u0456
      \u0447\u043E\u0440\u043D\u0438\u043B\u0430 \u0443 \u0432\u043E\u0434\u0443.
      \u041F\u0440\u0438 \u043D\u0430\u0431\u043B\u0438\u0436\u0435\u043D\u0456 \u0434\u043E
      \u0434\u0435\u044F\u043A\u0438\u0445 \u043A\u043E\u043B\u044C\u043E\u0440\u043E\u0432\u0438\u0445
      \u0432\u0435\u043B\u0438\u043A\u0438\u0445 \u043E\u0431'\u0454\u043A\u0442\u0456\u0432
      - \u0437\u043C\u0456\u043D\u044E\u0454 \u043A\u043E\u043B\u0456\u0440 \u0441\u0432\u043E\u0433\u043E
      \u043C\u0430\u0441\u043A\u0443\u0432\u0430\u043D\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 683583313833984
    m_Localized: "\u0414\u043E\u0441\u043B\u0456\u0434\u0436\u0435\u043D\u043D\u044F
      \u0411\u0456\u043E\u043C\u0443"
    m_Metadata:
      m_Items: []
