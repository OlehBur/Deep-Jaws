    m_Localized: "\u041F\u0440\u0438\u0441\u043A\u043E\u0440\u0438\u0442\u0438 \u0414\u043E\u0441\u043B\u0456\u0434\u0436\u0435\u043D\u043D\u044F
      \\n(-15\u0445\u0432)"
    m_Metadata:
