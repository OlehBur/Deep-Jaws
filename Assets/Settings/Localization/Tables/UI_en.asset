      m_Items: []
  - m_Id: 45985350800666624
    m_Localized: Select Game Mode
    m_Metadata:
      m_Items: []
  - m_Id: 45985685065723904
    m_Localized: Deadly Maelstrom
    m_Metadata:
      m_Items: []
  - m_Id: 45985355057885184
    m_Localized: Ocean Voyage
    m_Metadata:
      m_Items: []
  - m_Id: 45985353409523712
    m_Localized: Harbor Breeze
    m_Metadata:
      m_Items: []
  - m_Id: 45986534294843392
    m_Localized: "\tThis is <u>easiest game mode</u>. Enemies deal very little damage,
      and their spawn rate is very low and they also grow three times slower. Choose
      this mode if you\u2019re playing for the first time and just want to enjoy
      an almost carefree swim.\n<u>\tThe lowest earnings from sea shells. Unavailable
      quests from the Marine Sanctuary.</u>"
    m_Metadata:
      m_Items: []
  - m_Id: 45986604117422080
    m_Localized: "\tThis mode is the <u>classic base version</u>. Enemies deal the
      same amount of damage as you do, and their spawn rate is balanced for an engaging
      gameplay experience. Choose this mode if you want to enjoy the game as it was
      originally designed from the very beginning."
    m_Metadata:
      m_Items: []
  - m_Id: 45986606533341184
    m_Localized: "\t<u>The hardest game mode</u>. Enemy fish spawn in the same numbers
      as peaceful ones. Death is permanent, and you will lose all game progress.
      Fish of your own species will now attack you if you are smaller. This mode
      is designed for those who find the previous ones too easy. Choose it only if
      you promise not to give the game the lowest rating because of its difficulty.\n\t<u>Highest
      shell earnings.</u>"
    m_Metadata:
      m_Items: []
  - m_Id: 114155322680569856
    m_Localized: The ocean consumed you
    m_Metadata:
      m_Items: []
  - m_Id: 114177700735250432
    m_Localized: Retry from Lower Stage
    m_Metadata:
      m_Items: []
  - m_Id: 114177730430922752
    m_Localized: Instant Revive (Ad)
    m_Metadata:
      m_Items: []
  - m_Id: 114664986816049152
    m_Localized: 'Revives Left Today: '
    m_Metadata:
      m_Items: []
  - m_Id: 115270974627672064
    m_Localized: Loyalty Rewarded!
    m_Metadata:
      m_Items: []
  - m_Id: 115271348147220480
    m_Localized: "You bought this game back when it was paid, and I haven't forgotten
      that. You supported me, so now it's my turn to support you.\nYour account has
      been upgraded to Premium Founder forever!\n\u2022 No Interstitial Ads\n\u2022
      Free Instant Revives (limited per day)\nDive back in and rule the deep!"
    m_Metadata:
      m_Items: []
  - m_Id: 115537725315641344
    m_Localized: 'Automatic Respawn in '
    m_Metadata:
      m_Items: []
