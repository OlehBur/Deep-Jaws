  - m_Id: 117439701141975040
    m_Localized: No Internet Connection
    m_Metadata:
      m_Items: []
  - m_Id: 117439879345369088
    m_Localized: "You are currently offline.  \r\nAn internet connection is required
      to access achievements, leaderboards, and the store with exclusive items, as
      well as to claim unique rewards.  \r\n\r\nPlease check that you have a stable
      connection and restart the game.\r\n"
    m_Metadata:
      m_Items: []
  - m_Id: 117510486711889920
    m_Localized: Purchased
    m_Metadata:
      m_Items: []
  - m_Id: 117510546602356736
    m_Localized: Selected
    m_Metadata:
      m_Items: []
  - m_Id: 117510603175129088
