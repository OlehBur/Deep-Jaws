    m_Localized: Restore Purchases
    m_Metadata:
      m_Items: []
  - m_Id: 123258979858542592
    m_Localized: First Game Setup
    m_Metadata:
      m_Items: []
  - m_Id: 123259300961873920
    m_Localized: "\tThank you for downloading our game! To confirm the license and
      configure security, a one\u2011time connection to the Internet is required.\n\tPlease
      enable Wi\u2011Fi or mobile data and press the button below. On subsequent
      launches, the game will run completely offline."
    m_Metadata:
      m_Items: []
  - m_Id: 123259699752103936
    m_Localized: Check Again
    m_Metadata:
      m_Items: []
  - m_Id: 123260350309625856
    m_Localized: App Verification Error
    m_Metadata:
      m_Items: []
  - m_Id: 123260534586372096
    m_Localized: "\tSorry for the inconvenience. The system was unable to verify
      the license of this copy of the game.\nPossible reasons:\n\u2003\u2022 You
      are using an unofficial version of the game, downloaded outside of Google Play
      Store.\n\u2003If you purchased the game officially, please ensure a stable
      internet connection and try again. Otherwise, please support the developer
      and install the official version."
    m_Metadata:
      m_Items: []
